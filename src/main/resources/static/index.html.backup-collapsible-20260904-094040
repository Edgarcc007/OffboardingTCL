<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate">
<meta http-equiv="Pragma" content="no-cache">
<meta http-equiv="Expires" content="0">
<title>Control de Bajas de Personal</title>

<style>
*{box-sizing:border-box}

body{
  font-family:system-ui,Segoe UI,sans-serif;
  margin:0;
  background:#eef1f5;
  color:#1c2530
}

header{
  background:#12263f;
  color:#fff;
  padding:18px 26px
}

header h1{
  margin:0;
  font-size:19px;
  letter-spacing:.3px
}

header p{
  margin:4px 0 0;
  font-size:13px;
  opacity:.75
}

main{
  max-width:1180px;
  margin:22px auto;
  padding:0 16px
}

.hidden{
  display:none!important
}

.card{
  background:#fff;
  border-radius:8px;
  padding:18px 20px;
  margin-bottom:18px;
  box-shadow:0 1px 3px rgba(0,0,0,.12)
}

.card h2{
  margin:0 0 14px;
  font-size:15px;
  text-transform:uppercase;
  letter-spacing:.6px;
  color:#3f5875;
  border-bottom:2px solid #e3e8ee;
  padding-bottom:8px
}

.session-card{
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:16px;
  flex-wrap:wrap
}

.session-info{
  font-size:13px;
  color:#42556c
}

.session-info strong{
  color:#12263f
}

.session-roles{
  margin-top:5px;
  font-size:11px;
  color:#66788c
}

.profile-label{
  display:inline-block;
  margin-top:7px;
  padding:3px 10px;
  border-radius:12px;
  background:#d7e9fb;
  color:#14548c;
  font-size:11px;
  font-weight:700
}

.session-actions{
  display:flex;
  align-items:center;
  gap:8px
}

.session-actions form{
  margin:0
}

.session-actions button{
  margin-top:0
}

button.logout{
  background:#b3261e
}

button.logout:hover{
  background:#8e1d17
}

label{
  display:block;
  font-size:12px;
  font-weight:600;
  color:#5a6b7f;
  margin:8px 0 3px
}

input,select,textarea{
  width:100%;
  padding:8px 10px;
  border:1px solid #c8d2de;
  border-radius:5px;
  font-size:13px;
  font-family:inherit
}

.grid{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(210px,1fr));
  gap:0 14px
}

button{
  background:#12263f;
  color:#fff;
  border:0;
  padding:9px 16px;
  border-radius:5px;
  cursor:pointer;
  font-size:13px;
  font-weight:600;
  margin-top:12px
}

button:hover{
  background:#1d3a5f
}

button.mini{
  padding:5px 10px;
  font-size:11px;
  margin:2px 3px 2px 0
}

button.ok{
  background:#1c7a4a
}

button.ok:hover{
  background:#239159
}

button.val{
  background:#8a5a00
}

button.val:hover{
  background:#a86e00
}

table{
  width:100%;
  border-collapse:collapse;
  font-size:13px
}

th{
  background:#f4f7fa;
  text-align:left;
  padding:8px;
  font-size:11px;
  text-transform:uppercase;
  color:#5a6b7f;
  border-bottom:2px solid #e3e8ee
}

td{
  padding:8px;
  border-bottom:1px solid #eef1f5;
  vertical-align:top
}

.table-wrapper{
  width:100%;
  overflow-x:auto
}

.pill{
  display:inline-block;
  padding:2px 9px;
  border-radius:11px;
  font-size:11px;
  font-weight:700;
  margin:1px
}

.PENDIENTE{
  background:#fdf0d5;
  color:#8a5a00
}

.COMPLETADA{
  background:#d7e9fb;
  color:#14548c
}

.VALIDADA{
  background:#d5f0e0;
  color:#146c42
}

.CRITICO,.ALTO{
  background:#fbdcd8;
  color:#a52314
}

.NORMAL,.BAJO{
  background:#e2e7ee;
  color:#42556c
}

.crit{
  color:#a52314;
  font-weight:700
}

.caso{
  border:1px solid #dde4ec;
  border-radius:7px;
  margin-bottom:14px;
  overflow:hidden
}

.caso-h{
  background:#f7f9fc;
  padding:11px 14px;
  border-bottom:1px solid #dde4ec
}

.caso-h b{
  font-size:14px
}

.meta{
  font-size:12px;
  color:#5a6b7f;
  margin-top:3px
}

.notice{
  border-radius:6px;
  padding:10px 12px;
  margin-top:12px;
  font-size:13px;
  display:none
}

.notice.ok{
  display:block;
  color:#146c42;
  background:#d5f0e0;
  border:1px solid #acd9bf
}

.notice.error{
  display:block;
  color:#a52314;
  background:#fbdcd8;
  border:1px solid #e9b1aa
}

#log{
  background:#0f1b2b;
  color:#b8f0c8;
  font-family:Consolas,monospace;
  font-size:12px;
  padding:12px;
  border-radius:6px;
  height:150px;
  overflow-y:auto;
  white-space:pre-wrap
}

.err{color:#ff8f7d}
.warn{color:#ffd479}
</style>
</head>

<body>

<header>
  <h1>Control de Bajas de Personal</h1>
  <p>Revocación de accesos con evidencia, doble validación y bitácora inmutable</p>
</header>

<main>

<div class="card session-card">
  <div class="session-info">
    <div>
      <strong>Usuario conectado:</strong>
      <span id="usuario_actual">Cargando...</span>
    </div>

    <div id="roles_actuales" class="session-roles"></div>
    <div id="perfil_actual" class="profile-label hidden"></div>
  </div>

  <div class="session-actions">
    <button
      id="btn_recargar"
      type="button"
      onclick="recargar()">
      Recargar información
    </button>

    <form method="post" action="/logout">
      <button type="submit" class="logout">
        Cerrar sesión
      </button>
    </form>
  </div>
</div>

<div id="sin_permisos" class="card hidden">
  <h2>Acceso sin perfil</h2>
  <p>
    Tu cuenta está activa, pero no tiene un perfil autorizado.
    Contacta al administrador de Offboarding.
  </p>
</div>

<div id="seccion_captura" class="card hidden">
  <h2>Capturar baja de personal</h2>

  <div class="grid">
    <div>
      <label>Nombre del empleado</label>
      <input id="n" autocomplete="off" placeholder="Nombre completo">
    </div>

    <div>
      <label>Número o identificador de empleado</label>
      <input id="idf" autocomplete="off" placeholder="Número de empleado">
    </div>

    <div>
      <label>Correo corporativo</label>
      <input id="mail" autocomplete="off" placeholder="empleado@empresa.com">
    </div>

    <div>
      <label>Departamento</label>
      <input id="dep" autocomplete="off" placeholder="Departamento">
    </div>

    <div>
      <label>Jefe directo</label>
      <input id="jefe" autocomplete="off" placeholder="Nombre del jefe">
    </div>

    <div>
      <label>Tipo de baja</label>
      <select id="tipo">
        <option value="" selected disabled>Selecciona el tipo</option>
        <option>RENUNCIA</option>
        <option>DESPIDO</option>
        <option>FIN_DE_CONTRATO</option>
        <option>JUBILACION</option>
        <option>MUTUO_ACUERDO</option>
        <option>FALLECIMIENTO</option>
      </select>
    </div>

    <div>
      <label>Fecha efectiva</label>
      <input id="fecha" type="datetime-local">
    </div>

    <div>
      <label>Nivel de riesgo</label>
      <select id="riesgo">
        <option value="" selected disabled>Selecciona el riesgo</option>
        <option>BAJO</option>
        <option>NORMAL</option>
        <option>ALTO</option>
        <option>CRITICO</option>
      </select>
    </div>

    <div>
      <label>Confidencial</label>
      <select id="conf">
        <option value="" selected disabled>Selecciona una opción</option>
        <option value="false">No</option>
        <option value="true">Sí</option>
      </select>
    </div>
  </div>

  <label>Observaciones</label>
  <textarea id="obs" autocomplete="off" rows="3"></textarea>

  <button onclick="crearCaso()">
    Registrar baja
  </button>

  <div id="resultado_captura" class="notice"></div>
</div>

<div id="seccion_usuarios" class="card hidden">
  <h2>Administración de usuarios</h2>

  <div class="grid">
    <div>
      <label>Usuario</label>
      <input id="nu_user" autocomplete="off" placeholder="nombre.apellido">
    </div>

    <div>
      <label>Nombre completo</label>
      <input id="nu_nombre" autocomplete="off" placeholder="Nombre Apellido">
    </div>

    <div>
      <label>Correo</label>
      <input id="nu_mail" autocomplete="off" placeholder="usuario@empresa.com">
    </div>

    <div>
      <label>Contraseña inicial</label>
      <input id="nu_pass" type="password" autocomplete="new-password"
        placeholder="Mínimo 12 caracteres">

      <button
        class="mini"
        type="button"
        onclick="generarPass()">
        Generar
      </button>
    </div>
  </div>

  <label>Perfiles asignados</label>

  <div style="font-size:13px;line-height:1.9;padding:6px 0">

    <label style="display:inline-block;margin-right:20px;font-weight:400">
      <input
        type="checkbox"
        class="rol"
        value="RECURSOS_HUMANOS"
        style="width:auto">
      <b>Recursos Humanos</b> — solamente captura
    </label>

    <label style="display:inline-block;margin-right:20px;font-weight:400">
      <input
        type="checkbox"
        class="rol"
        value="IT_ENGINEER"
        style="width:auto">
      <b>IT Engineer</b> — procesa tareas
    </label>

    <label style="display:inline-block;margin-right:20px;font-weight:400">
      <input
        type="checkbox"
        class="rol"
        value="AUDITOR"
        style="width:auto">
      <b>Auditor</b> — consulta de solo lectura
    </label>

    <label style="display:inline-block;margin-right:20px;font-weight:400">
      <input
        type="checkbox"
        class="rol"
        value="ADMIN"
        style="width:auto">
      <b>Administrador</b> — control completo
    </label>
  </div>

  <div
    id="nu_aviso"
    style="font-size:12px;color:#a52314;font-weight:600;min-height:17px">
  </div>

  <button onclick="crearUsuario()">
    Crear usuario
  </button>

  <div class="table-wrapper" style="margin-top:18px">
    <table>
      <thead>
        <tr>
          <th>#</th>
          <th>Usuario</th>
          <th>Nombre</th>
          <th>Correo</th>
          <th>Perfiles</th>
          <th>Estado</th>
        </tr>
      </thead>
      <tbody id="tabla_usuarios"></tbody>
    </table>
  </div>
</div>

<div id="seccion_casos" class="card hidden">
  <h2 id="titulo_casos">Casos y tareas</h2>
  <div id="casos">Cargando...</div>
</div>

<div id="seccion_auditoria" class="card hidden">
  <h2>Bitácora de auditoría</h2>

  <div class="table-wrapper">
    <table>
      <thead>
        <tr>
          <th>#</th>
          <th>Fecha</th>
          <th>Actor</th>
          <th>Acción</th>
          <th>Entidad</th>
          <th>Detalle</th>
        </tr>
      </thead>
      <tbody id="audit"></tbody>
    </table>
  </div>
</div>

<div id="seccion_log" class="card hidden">
  <h2>Actividad de la sesión</h2>
  <div id="log"></div>
</div>

</main>

<script>
const $ = id => document.getElementById(id);

let rolesActuales = new Set();

function tieneRol(rol) {
  return rolesActuales.has(rol);
}

function mostrar(id, visible) {
  const elemento = $(id);

  if (!elemento) {
    return;
  }

  elemento.classList.toggle('hidden', !visible);
}

function esc(valor) {
  return (valor == null ? '' : String(valor))
    .replace(/[<>&]/g, caracter => ({
      '<': '&lt;',
      '>': '&gt;',
      '&': '&amp;'
    }[caracter]));
}

function log(mensaje, clase) {
  const contenedor = $('log');

  if (!contenedor) {
    return;
  }

  const linea = document.createElement('div');

  if (clase) {
    linea.className = clase;
  }

  linea.textContent =
    new Date().toLocaleTimeString() + '  ' + mensaje;

  contenedor.prepend(linea);
}

async function api(path, method, body) {
  const respuesta = await fetch(path, {
    method: method || 'GET',
    headers: {
      'Content-Type': 'application/json'
    },
    body: body ? JSON.stringify(body) : undefined
  });

  if (respuesta.status === 401) {
    window.location.replace('/login.html?expired');

    return {
      status: 401,
      data: null
    };
  }

  let data = null;

  try {
    data = await respuesta.json();
  }
  catch (error) {
    data = null;
  }

  return {
    status: respuesta.status,
    data: data
  };
}

function nombrePerfil() {
  if (tieneRol('ADMIN')) {
    return 'Administrador';
  }

  if (tieneRol('RECURSOS_HUMANOS')) {
    return 'Recursos Humanos — solamente captura';
  }

  if (tieneRol('IT_ENGINEER')) {
    return 'IT Engineer — procesamiento de bajas';
  }

  if (tieneRol('AUDITOR')) {
    return 'Auditor — solo lectura';
  }

  return 'Sin perfil autorizado';
}

function aplicarPermisos() {
  const esAdmin = tieneRol('ADMIN');
  const esRH = tieneRol('RECURSOS_HUMANOS');
  const esEngineer = tieneRol('IT_ENGINEER');
  const esAuditor = tieneRol('AUDITOR');

  const tienePerfil =
    esAdmin ||
    esRH ||
    esEngineer ||
    esAuditor;

  mostrar('perfil_actual', true);
  $('perfil_actual').textContent = nombrePerfil();

  mostrar('sin_permisos', !tienePerfil);
  mostrar('seccion_captura', esAdmin || esRH);
  mostrar('seccion_usuarios', esAdmin);
  mostrar('seccion_casos', esAdmin || esEngineer || esAuditor);
  mostrar('seccion_auditoria', esAdmin || esAuditor);
  mostrar('seccion_log', esAdmin || esEngineer);

  mostrar(
    'btn_recargar',
    esAdmin || esEngineer || esAuditor
  );

  if (esAuditor && !esAdmin) {
    $('titulo_casos').textContent =
      'Consulta de casos y tareas — solo lectura';
  }
  else if (esEngineer && !esAdmin) {
    $('titulo_casos').textContent =
      'Procesamiento de bajas — IT Engineer';
  }
  else {
    $('titulo_casos').textContent =
      'Casos y tareas';
  }
}

async function cargarSesion() {
  const respuesta = await api('/api/auth/me');

  if (respuesta.status !== 200 || !respuesta.data) {
    return false;
  }

  $('usuario_actual').textContent =
    respuesta.data.username || 'Usuario';

  const roles = Array.isArray(respuesta.data.roles)
    ? respuesta.data.roles
    : [];

  rolesActuales = new Set(roles);

  $('roles_actuales').textContent = roles.length
    ? 'Perfiles: ' + roles.join(', ')
    : 'Sin perfiles asignados';

  aplicarPermisos();

  return true;
}

function accionesTarea(tarea) {
  const puedeCompletar =
    tieneRol('ADMIN') ||
    tieneRol('IT_ENGINEER');

  const puedeValidar =
    tieneRol('ADMIN');

  const botones = [];

  if (puedeCompletar && tarea.status === 'PENDIENTE') {
    botones.push(
      `<button class="mini ok" onclick="completar(${tarea.id})">Completar</button>`
    );
  }

  if (
    puedeValidar &&
    tarea.critical &&
    tarea.status === 'COMPLETADA'
  ) {
    botones.push(
      `<button class="mini val" onclick="validar(${tarea.id})">Validar</button>`
    );
  }

  return botones.length
    ? botones.join('')
    : '<span style="color:#78899b">Solo lectura</span>';
}

async function cargarCasos() {
  const respuesta = await api('/api/offboardings');

  if (respuesta.status !== 200) {
    $('casos').innerHTML =
      'No fue posible consultar los casos. HTTP ' +
      respuesta.status;

    log(
      'GET /api/offboardings -> ' + respuesta.status,
      'err'
    );

    return;
  }

  if (!respuesta.data.length) {
    $('casos').innerHTML =
      'No hay casos registrados.';

    return;
  }

  $('casos').innerHTML = respuesta.data.map(caso => `
    <div class="caso">
      <div class="caso-h">
        <b>${esc(caso.caseNumber)}</b>
        &nbsp;
        ${esc(caso.employeeName)}

        <span class="pill ${esc(caso.riskLevel)}">
          ${esc(caso.riskLevel)}
        </span>

        <span class="pill ${esc(caso.status)}">
          ${esc(caso.status)}
        </span>

        ${caso.confidential
          ? '<span class="pill CRITICO">CONFIDENCIAL</span>'
          : ''}

        <div class="meta">
          ${esc(caso.department || '-')}
          &middot;
          ${esc(caso.terminationType)}
          &middot;
          efectiva ${new Date(caso.effectiveAt).toLocaleString()}
          &middot;
          solicitó ${esc(caso.requestedBy)}
        </div>
      </div>

      <div class="table-wrapper">
        <table>
          <thead>
            <tr>
              <th>Sistema</th>
              <th>Tarea</th>
              <th>Vence</th>
              <th>Estado</th>
              <th>Evidencia</th>
              <th>Ejecutó</th>
              <th>Validó</th>
              <th>Acciones</th>
            </tr>
          </thead>

          <tbody>
            ${(caso.tasks || [])
              .sort((a, b) => a.id - b.id)
              .map(tarea => `
                <tr>
                  <td>
                    ${esc(tarea.systemName)}
                    ${tarea.critical
                      ? '<span class="crit">*</span>'
                      : ''}
                  </td>

                  <td>${esc(tarea.taskName)}</td>

                  <td>
                    ${new Date(tarea.dueAt).toLocaleString()}
                  </td>

                  <td>
                    <span class="pill ${esc(tarea.status)}">
                      ${esc(tarea.status)}
                    </span>
                  </td>

                  <td>${esc(tarea.evidenceReference || '-')}</td>
                  <td>${esc(tarea.completedBy || '-')}</td>
                  <td>${esc(tarea.validatedBy || '-')}</td>
                  <td>${accionesTarea(tarea)}</td>
                </tr>
              `).join('')}
          </tbody>
        </table>
      </div>
    </div>
  `).join('');
}

async function cargarAudit() {
  const respuesta = await api('/api/audit');

  if (respuesta.status !== 200) {
    $('audit').innerHTML = `
      <tr>
        <td colspan="6">
          No fue posible consultar la bitácora.
          HTTP ${respuesta.status}
        </td>
      </tr>
    `;

    return;
  }

  $('audit').innerHTML = respuesta.data.map(evento => `
    <tr>
      <td>${evento.id}</td>
      <td>${new Date(evento.occurredAt).toLocaleString()}</td>
      <td><b>${esc(evento.actor)}</b></td>
      <td>${esc(evento.action)}</td>
      <td>
        ${esc(evento.entityType)}
        #${evento.entityId == null ? '-' : evento.entityId}
      </td>
      <td>${esc(evento.details)}</td>
    </tr>
  `).join('');
}

async function completar(id) {
  if (
    !tieneRol('ADMIN') &&
    !tieneRol('IT_ENGINEER')
  ) {
    return;
  }

  const evidencia = prompt(
    'Referencia de evidencia (ticket, folio o captura):',
    'TICKET-INC-'
  );

  if (!evidencia) {
    return;
  }

  const comentarios = prompt(
    'Comentarios opcionales:',
    ''
  ) || null;

  const respuesta = await api(
    '/api/tasks/' + id + '/complete',
    'PATCH',
    {
      evidenceReference: evidencia,
      comments: comentarios
    }
  );

  log(
    `PATCH /api/tasks/${id}/complete -> ${respuesta.status}`,
    respuesta.status === 200 ? null : 'err'
  );

  await recargar();
}

async function validar(id) {
  if (!tieneRol('ADMIN')) {
    return;
  }

  const respuesta = await api(
    '/api/tasks/' + id + '/validate',
    'PATCH'
  );

  if (respuesta.status === 200) {
    log(
      `Tarea ${id} validada por ${respuesta.data.validatedBy}`
    );
  }
  else if (respuesta.status === 403) {
    log(
      'La validación debe realizarla una persona diferente a quien completó la tarea.',
      'warn'
    );
  }
  else {
    log(
      `Error validando tarea ${id}: HTTP ${respuesta.status}`,
      'err'
    );
  }

  await recargar();
}

function limpiarCaptura() {
  $('n').value = '';
  $('idf').value = '';
  $('mail').value = '';
  $('dep').value = '';
  $('jefe').value = '';
  $('obs').value = '';
  $('tipo').value = '';
  $('conf').value = '';
  $('riesgo').value = '';
  $('fecha').value = '';

  const resultado = $('resultado_captura');

  if (resultado) {
    resultado.className = 'notice';
    resultado.textContent = '';
  }

  $('n').focus();
}

async function crearCaso() {
  const resultado = $('resultado_captura');

  resultado.className = 'notice';
  resultado.textContent = '';

  const fecha = $('fecha').value;

  if (!$('n').value.trim()) {
    resultado.className = 'notice error';
    resultado.textContent =
      'Escribe el nombre del empleado.';

    return;
  }

  if (!$('idf').value.trim()) {
    resultado.className = 'notice error';
    resultado.textContent =
      'Escribe el identificador del empleado.';

    return;
  }

  if (!fecha) {
    resultado.className = 'notice error';
    resultado.textContent =
      'Indica la fecha efectiva de la baja.';

    return;
  }

  const respuesta = await api(
    '/api/offboardings',
    'POST',
    {
      employeeName: $('n').value.trim(),
      employeeIdentifier: $('idf').value.trim(),
      corporateEmail: $('mail').value.trim(),
      department: $('dep').value.trim(),
      managerName: $('jefe').value.trim(),
      terminationType: $('tipo').value,
      effectiveAt: new Date(fecha).toISOString(),
      riskLevel: $('riesgo').value,
      confidential: $('conf').value === 'true',
      observations: $('obs').value.trim() || null
    }
  );

  if (respuesta.status === 201) {
    resultado.className = 'notice ok';
    resultado.textContent =
      'Baja registrada correctamente. Caso: ' +
      respuesta.data.caseNumber;

    limpiarCaptura();

    if (tieneRol('ADMIN')) {
      await cargarCasos();
    }
  }
  else {
    resultado.className = 'notice error';
    resultado.textContent =
      respuesta.data && respuesta.data.detail
        ? respuesta.data.detail
        : 'Error registrando la baja. HTTP ' +
          respuesta.status;
  }
}

function generarPass() {
  const mayusculas = 'ABCDEFGHJKLMNPQRSTUVWXYZ';
  const minusculas = 'abcdefghijkmnopqrstuvwxyz';
  const numeros = '23456789';
  const simbolos = '#$%&*+-';
  const todos =
    mayusculas +
    minusculas +
    numeros +
    simbolos;

  let password = '';

  password += mayusculas[
    Math.floor(Math.random() * mayusculas.length)
  ];

  password += minusculas[
    Math.floor(Math.random() * minusculas.length)
  ];

  password += numeros[
    Math.floor(Math.random() * numeros.length)
  ];

  password += simbolos[
    Math.floor(Math.random() * simbolos.length)
  ];

  for (let i = 0; i < 12; i++) {
    password += todos[
      Math.floor(Math.random() * todos.length)
    ];
  }

  $('nu_pass').type = 'text';
  $('nu_pass').value = password;
}

async function crearUsuario() {
  if (!tieneRol('ADMIN')) {
    return;
  }

  const roles = Array
    .from(document.querySelectorAll('.rol:checked'))
    .map(control => control.value);

  const aviso = $('nu_aviso');

  aviso.textContent = '';

  if (
    !$('nu_user').value.trim() ||
    !$('nu_nombre').value.trim() ||
    !$('nu_mail').value.trim()
  ) {
    aviso.textContent =
      'Faltan datos obligatorios.';

    return;
  }

  if (($('nu_pass').value || '').length < 12) {
    aviso.textContent =
      'La contraseña debe tener al menos 12 caracteres.';

    return;
  }

  if (!roles.length) {
    aviso.textContent =
      'Asigna al menos un perfil.';

    return;
  }

  const respuesta = await api(
    '/api/users',
    'POST',
    {
      username: $('nu_user').value.trim(),
      fullName: $('nu_nombre').value.trim(),
      email: $('nu_mail').value.trim(),
      password: $('nu_pass').value,
      roles: roles
    }
  );

  if (respuesta.status === 201) {
    alert(
      'Usuario creado correctamente.\n\n' +
      'Usuario: ' + $('nu_user').value.trim() + '\n' +
      'Contraseña: ' + $('nu_pass').value + '\n\n' +
      'Esta contraseña no volverá a mostrarse.'
    );

    $('nu_user').value = '';
    $('nu_nombre').value = '';
    $('nu_mail').value = '';
    $('nu_pass').value = '';
    $('nu_pass').type = 'password';

    document
      .querySelectorAll('.rol:checked')
      .forEach(control => control.checked = false);

    await cargarUsuarios();
    await cargarAudit();
  }
  else {
    aviso.textContent =
      respuesta.data && respuesta.data.detail
        ? respuesta.data.detail
        : 'Error HTTP ' + respuesta.status;
  }
}

async function cargarUsuarios() {
  const respuesta = await api('/api/users');
  const tabla = $('tabla_usuarios');

  if (respuesta.status !== 200) {
    tabla.innerHTML = `
      <tr>
        <td colspan="6">
          No fue posible consultar usuarios.
          HTTP ${respuesta.status}
        </td>
      </tr>
    `;

    return;
  }

  const usuarios = Array.isArray(respuesta.data)
    ? respuesta.data
    : respuesta.data.content || [];

  tabla.innerHTML = usuarios.map(usuario => `
    <tr>
      <td>${usuario.id}</td>
      <td><b>${esc(usuario.username)}</b></td>
      <td>${esc(usuario.fullName)}</td>
      <td>${esc(usuario.email)}</td>
      <td>
        ${(usuario.roles || []).map(rol => `
          <span class="pill NORMAL">${esc(rol)}</span>
        `).join(' ')}
      </td>
      <td>
        ${usuario.enabled === false
          ? '<span class="pill CRITICO">INACTIVO</span>'
          : '<span class="pill VALIDADA">ACTIVO</span>'}
      </td>
    </tr>
  `).join('');
}

async function recargar() {
  const tareas = [];

  if (
    tieneRol('ADMIN') ||
    tieneRol('IT_ENGINEER') ||
    tieneRol('AUDITOR')
  ) {
    tareas.push(cargarCasos());
  }

  if (
    tieneRol('ADMIN') ||
    tieneRol('AUDITOR')
  ) {
    tareas.push(cargarAudit());
  }

  if (tieneRol('ADMIN')) {
    tareas.push(cargarUsuarios());
  }

  await Promise.all(tareas);
}

async function iniciar() {
  limpiarCaptura();

  const sesionValida = await cargarSesion();

  if (!sesionValida) {
    return;
  }

  await recargar();
}

iniciar();

setInterval(() => {
  recargar();
}, 15000);
</script>

