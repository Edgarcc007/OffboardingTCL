<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate">
<meta http-equiv="Pragma" content="no-cache">
<meta http-equiv="Expires" content="0">
<title>Employee Offboarding Control</title>

<style>
*{box-sizing:border-box}

body{
  font-family:system-ui,Segoe UI,sans-serif;
  margin:0;
  background:#eef1f5;
  color:#1c2530
}

header{
  background:#12263f;
  color:#fff;
  padding:18px 26px
}

header h1{
  margin:0;
  font-size:19px;
  letter-spacing:.3px
}

header p{
  margin:4px 0 0;
  font-size:13px;
  opacity:.75
}

main{
  max-width:1180px;
  margin:22px auto;
  padding:0 16px
}

.hidden{
  display:none!important
}

.card{
  background:#fff;
  border-radius:8px;
  padding:18px 20px;
  margin-bottom:18px;
  box-shadow:0 1px 3px rgba(0,0,0,.12)
}

.card h2{
  margin:0 0 14px;
  font-size:15px;
  text-transform:uppercase;
  letter-spacing:.6px;
  color:#3f5875;
  border-bottom:2px solid #e3e8ee;
  padding-bottom:8px
}

.session-card{
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:16px;
  flex-wrap:wrap
}

.session-info{
  font-size:13px;
  color:#42556c
}

.session-info strong{
  color:#12263f
}

.session-roles{
  margin-top:5px;
  font-size:11px;
  color:#66788c
}

.profile-label{
  display:inline-block;
  margin-top:7px;
  padding:3px 10px;
  border-radius:12px;
  background:#d7e9fb;
  color:#14548c;
  font-size:11px;
  font-weight:700
}

.session-actions{
  display:flex;
  align-items:center;
  gap:8px
}

.session-actions form{
  margin:0
}

.session-actions button{
  margin-top:0
}

button.logout{
  background:#b3261e
}

button.logout:hover{
  background:#8e1d17
}

label{
  display:block;
  font-size:12px;
  font-weight:600;
  color:#5a6b7f;
  margin:8px 0 3px
}

input,select,textarea{
  width:100%;
  padding:8px 10px;
  border:1px solid #c8d2de;
  border-radius:5px;
  font-size:13px;
  font-family:inherit
}

.grid{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(210px,1fr));
  gap:0 14px
}

button{
  background:#12263f;
  color:#fff;
  border:0;
  padding:9px 16px;
  border-radius:5px;
  cursor:pointer;
  font-size:13px;
  font-weight:600;
  margin-top:12px
}

button:hover{
  background:#1d3a5f
}

button.mini{
  padding:5px 10px;
  font-size:11px;
  margin:2px 3px 2px 0
}

button.ok{
  background:#1c7a4a
}

button.ok:hover{
  background:#239159
}

button.val{
  background:#8a5a00
}

button.val:hover{
  background:#a86e00
}

table{
  width:100%;
  border-collapse:collapse;
  font-size:13px
}

th{
  background:#f4f7fa;
  text-align:left;
  padding:8px;
  font-size:11px;
  text-transform:uppercase;
  color:#5a6b7f;
  border-bottom:2px solid #e3e8ee
}

td{
  padding:8px;
  border-bottom:1px solid #eef1f5;
  vertical-align:top
}

.table-wrapper{
  width:100%;
  overflow-x:auto
}

.pill{
  display:inline-block;
  padding:2px 9px;
  border-radius:11px;
  font-size:11px;
  font-weight:700;
  margin:1px
}

.PENDIENTE{
  background:#fdf0d5;
  color:#8a5a00
}

.COMPLETADA{
  background:#d7e9fb;
  color:#14548c
}

.VALIDADA{
  background:#d5f0e0;
  color:#146c42
}

.CRITICO,.ALTO{
  background:#fbdcd8;
  color:#a52314
}

.NORMAL,.BAJO{
  background:#e2e7ee;
  color:#42556c
}

.crit{
  color:#a52314;
  font-weight:700
}


.case-header{
  display:flex;
  align-items:center;
  gap:10px;
  width:100%
}

.case-toggle{
  flex:0 0 auto;
  width:31px;
  height:31px;
  margin:0;
  padding:0;
  border-radius:50%;
  background:#e5ebf2;
  color:#12263f;
  display:flex;
  align-items:center;
  justify-content:center;
  cursor:pointer
}

.case-toggle:hover{
  background:#d2dce8
}

.case-arrow{
  display:inline-block;
  font-size:13px;
  transition:transform .18s ease
}

.caso.expanded .case-arrow{
  transform:rotate(90deg)
}

.case-summary{
  flex:1;
  min-width:0
}

.case-summary-main{
  display:flex;
  align-items:center;
  gap:7px;
  flex-wrap:wrap
}

.case-summary-secondary{
  margin-top:3px;
  color:#5a6b7f;
  font-size:12px
}


.case-details-grid{
  display:grid;
  grid-template-columns:repeat(auto-fill,minmax(180px,1fr));
  gap:8px 16px;
  padding:12px 16px;
  margin-bottom:12px;
  background:#f8fafc;
  border-radius:6px;
  border:1px solid #e2e8f0;
  font-size:13px
}

.detail-group{
  display:flex;
  flex-direction:column;
  gap:2px
}

.detail-label{
  font-size:11px;
  color:#5a6b7f;
  text-transform:uppercase;
  letter-spacing:.5px
}

.detail-value{
  font-weight:500;
  color:#1e293b
}
.caso-body{
  display:none
}

.caso.expanded .caso-body{
  display:block
}

.case-count{
  color:#5a6b7f;
  font-size:11px;
  white-space:nowrap
}

.empty-row{
  padding:14px;
  text-align:center;
  color:#66788c
}

.caso{
  border:1px solid #dde4ec;
  border-radius:7px;
  margin-bottom:14px;
  overflow:hidden
}

.caso-h{
  background:#f7f9fc;
  padding:11px 14px;
  border-bottom:1px solid #dde4ec
}

.caso-h b{
  font-size:14px
}

.meta{
  font-size:12px;
  color:#5a6b7f;
  margin-top:3px
}

.notice{
  border-radius:6px;
  padding:10px 12px;
  margin-top:12px;
  font-size:13px;
  display:none
}

.notice.ok{
  display:block;
  color:#146c42;
  background:#d5f0e0;
  border:1px solid #acd9bf
}

.notice.error{
  display:block;
  color:#a52314;
  background:#fbdcd8;
  border:1px solid #e9b1aa
}

#log{
  background:#0f1b2b;
  color:#b8f0c8;
  font-family:Consolas,monospace;
  font-size:12px;
  padding:12px;
  border-radius:6px;
  height:150px;
  overflow-y:auto;
  white-space:pre-wrap
}

.err{color:#ff8f7d}
.warn{color:#ffd479}

.header-content{
  max-width:1180px;
  margin:0 auto;
  display:flex;
  align-items:center;
  gap:17px
}

.brand-logo{
  width:88px;
  height:auto;
  flex:0 0 auto;
  display:block
}

.header-text{
  min-width:0;
  flex:1
}

.header-department{
  margin-top:3px;
  color:#ffffff;
  font-size:13px;
  font-weight:700;
  letter-spacing:.4px
}

.week-indicator{
  flex:0 0 auto;
  background:rgba(255,255,255,.12);
  border:1px solid rgba(255,255,255,.23);
  border-radius:18px;
  padding:7px 13px;
  font-size:12px;
  font-weight:700;
  white-space:nowrap
}

.collapsible-card-header{
  display:flex;
  align-items:center;
  gap:10px;
  border-bottom:2px solid #e3e8ee;
  padding-bottom:8px;
  margin-bottom:0
}

.collapsible-card-header h2{
  flex:1;
  margin:0;
  padding:0;
  border:0
}

.audit-toggle{
  flex:0 0 auto;
  width:31px;
  height:31px;
  margin:0;
  padding:0;
  border-radius:50%;
  background:#e5ebf2;
  color:#12263f;
  display:flex;
  align-items:center;
  justify-content:center
}

.audit-toggle:hover{
  background:#d2dce8
}

.audit-arrow{
  display:inline-block;
  transition:transform .18s ease
}

#seccion_auditoria.expanded .audit-arrow{
  transform:rotate(90deg)
}

.audit-body{
  margin-top:14px
}

.reopen{
  background:#6d3fa0
}

.reopen:hover{
  background:#8150b6
}

@media(max-width:700px){
  .header-content{
    align-items:flex-start;
    flex-wrap:wrap
  }

  .brand-logo{
    width:70px
  }

  .week-indicator{
    width:100%;
    text-align:center
  }
}


.selection-panel{
  margin:18px 0;
  padding:16px;
  border:1px solid #d8e0e8;
  border-radius:8px;
  background:#f8fafc
}

.selection-panel legend{
  padding:0 8px;
  font-weight:700;
  color:#24364b
}

.selection-options{
  display:flex;
  flex-wrap:wrap;
  gap:8px 24px;
  margin:8px 0
}

.selection-option{
  display:inline-flex;
  align-items:center;
  gap:8px;
  margin:0;
  font-weight:500;
  cursor:pointer
}

.selection-option input{
  width:auto;
  margin:0
}

.assignment-detail{
  margin-top:13px
}

.assignment-detail label{
  display:block;
  margin-bottom:5px
}

.selection-help{
  margin:5px 0 12px;
  color:#66788c;
  font-size:12px
}


.password-grid{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
  gap:12px
}

.modal-overlay{
  position:fixed;
  inset:0;
  z-index:1000;
  display:flex;
  align-items:center;
  justify-content:center;
  padding:20px;
  background:rgba(0,0,0,.55)
}

.modal-panel{
  width:min(720px,100%);
  max-height:90vh;
  overflow:auto;
  padding:22px;
  border-radius:10px;
  background:#fff;
  box-shadow:0 18px 50px rgba(0,0,0,.3)
}

.modal-actions{
  display:flex;
  justify-content:flex-end;
  flex-wrap:wrap;
  gap:10px;
  margin-top:18px
}

.user-actions{
  white-space:nowrap
}


.required-marker{
  color:#c62828;
  font-weight:800;
  margin-left:3px
}

.optional-marker{
  color:#66788c;
  font-size:12px;
  font-weight:400
}

.required-legend{
  margin:4px 0 14px;
  color:#66788c;
  font-size:12px
}

.no-email{
  color:#78899a;
  font-size:12px;
  font-style:italic
}


/* -- Inventory lookup -- */
.inv-lookup-result{margin-top:6px;min-height:0}
.inv-lookup-result:empty{display:none}
.inv-tag{display:inline-flex;align-items:center;gap:6px;flex-wrap:wrap;padding:6px 12px;border-radius:6px;font-size:.82rem;line-height:1.4}
.inv-tag.found{background:#e8f5e9;border:1px solid #66bb6a;color:#2e7d32}
.inv-tag.not-found{background:#fff3e0;border:1px solid #ffa726;color:#e65100}
.inv-tag .inv-icon{font-size:1rem}
.inv-tag .inv-field{font-weight:600}
.inv-tag .inv-sep{opacity:.4}
.inv-tag-status{display:inline-block;padding:1px 7px;border-radius:3px;font-size:.75rem;font-weight:600}
.inv-tag-status.on-use{background:#c8e6c9;color:#1b5e20}
.inv-tag-status.inactive{background:#ffcdd2;color:#b71c1c}
.inv-tag-status.available{background:#bbdefb;color:#0d47a1}
.inv-tag-status.other{background:#e0e0e0;color:#424242}
.other-equip-row{display:flex;gap:8px;align-items:center;margin-top:6px}
.other-equip-row input{flex:1}
.btn-add-equip{width:36px;height:36px;border:none;border-radius:6px;background:#1976d2;color:#fff;font-size:1.3rem;font-weight:700;cursor:pointer;display:flex;align-items:center;justify-content:center;flex-shrink:0}
.btn-add-equip:hover{background:#1565c0}
.other-equip-item{display:flex;align-items:center;gap:8px;padding:6px 10px;margin-top:6px;background:#f5f5f5;border:1px solid #e0e0e0;border-radius:6px;font-size:.85rem}
.other-equip-item .equip-info{flex:1}
.other-equip-item .btn-remove-equip{background:none;border:none;color:#e53935;font-size:1.1rem;cursor:pointer;padding:2px 6px}
.other-equip-item .btn-remove-equip:hover{color:#b71c1c}
</style>
</head>

<body>

<header>
  <div class="header-content">

    <img
      src="/images/tcl-logo.svg"
      class="brand-logo"
      alt="TCL">

    <div class="header-text">
      <h1>Employee Offboarding Control</h1>

      <div class="header-department">
        Human Resources
      </div>

      <p>
        Access revocation with evidence,
        dual validation and an immutable audit log
      </p>
    </div>

    <div id="week_indicator" class="week-indicator">
      Calculating week...
    </div>

  </div>
</header>

<main>

<div class="card session-card">
  <div class="session-info">
    <div>
      <strong>Signed-in user:</strong>
      <span id="usuario_actual">Loading...</span>
    </div>

    <div id="roles_actuales" class="session-roles"></div>
    <div id="perfil_actual" class="profile-label hidden"></div>
  </div>

  <div class="session-actions">
    <button
      id="btn_recargar"
      type="button"
      onclick="recargar()">
      Refresh information
    </button>

    <form method="post" action="/logout">
      <button type="submit" class="logout">
        Sign out
      </button>
    </form>
  </div>
</div>


<div id="sin_permisos" class="card hidden">
  <h2>No assigned profile</h2>
  <p>
    Your account is active, but it does not have an authorized profile.
    Contact the Offboarding administrator.
  </p>
</div>

<div id="seccion_captura" class="card hidden">
  <h2>Register employee offboarding</h2>
  <p class="required-legend">
    <span class="required-marker">*</span>
    Required field. All other fields are optional.
  </p>


  <div class="grid">
        <div>
      <label>Employee number<span class="required-marker">*</span></label>
      <input id="idf" autocomplete="off"
             placeholder="Type number and press Enter"
             required aria-required="true"
             onblur="buscarEmpleado()"
             onkeydown="if(event.key==='Enter'){event.preventDefault();buscarEmpleado()}">
      <div id="idf_status" style="font-size:11px;margin-top:3px;min-height:15px"></div>
    </div>

    <div>
      <label>Employee name<span class="required-marker">*</span></label>
      <input id="n" autocomplete="off" placeholder="Auto-filled from employee number" required aria-required="true">
    </div>

    <div>
      <label>Corporate email <span class="optional-marker">(optional)</span></label>
      <input id="mail" type="email" autocomplete="off" placeholder="employee@company.com">
    </div>

    <div>
      <label>Department<span class="required-marker">*</span></label>
      <input id="dep" autocomplete="off" placeholder="Department" required aria-required="true">
    </div>


    <div>
      <label>Building <span class="optional-marker">(optional)</span></label>

      <input
        id="building"
        autocomplete="off"
        placeholder="Ejemplo: Building A">
    </div>

    <div>
      <label>Work area<span class="required-marker">*</span></label>

      <input
        id="work_area"
        autocomplete="off"
        placeholder="Example: Second floor - Finance" required aria-required="true">
    </div>

    <div>
      <label>Direct manager<span class="required-marker">*</span></label>
      <input id="jefe" autocomplete="off" placeholder="Manager name" required aria-required="true">
    </div>

    <div>
      <label>Offboarding type<span class="required-marker">*</span></label>
      <select id="tipo">
        <option value="" selected disabled>Select a type</option>
        <option value="RENUNCIA">Resignation</option>
        <option value="DESPIDO">Termination</option>
        <option value="FIN_DE_CONTRATO">End of contract</option>
        <option value="JUBILACION">Retirement</option>
        <option value="MUTUO_ACUERDO">Mutual agreement</option>
        <option value="FALLECIMIENTO">Deceased</option>
      </select>
    </div>

    <div>
      <label>Effective date<span class="required-marker">*</span></label>
      <input id="fecha" type="datetime-local">
    </div>

    <div>
      <label>Risk level <span class="optional-marker">(optional)</span></label>
      <select id="riesgo">
        <option value="" selected disabled>Select a risk level</option>
        <option value="BAJO">Low</option>
        <option value="NORMAL">Normal</option>
        <option value="ALTO">High</option>
        <option value="CRITICO">Critical</option>
      </select>
    </div>

    <div>
      <label>Confidential <span class="optional-marker">(optional)</span></label>
      <select id="conf">
        <option value="" selected disabled>Select an option</option>
        <option value="false">No</option>
        <option value="true">Yes</option>
      </select>
    </div>
  </div>


  <fieldset class="selection-panel">
    <legend>Equipment assigned to the employee <span class="optional-marker">(optional)</span></legend>

    <p class="selection-help">
      Seleccione los equipos que Human Resources tiene
      registrados como asignados.
    </p>

    <div class="selection-options">
      <label class="selection-option">
        <input
          id="eq_computer"
          type="checkbox"
          onchange="actualizarCamposAsignacion()">
        Computer
      </label>

      <label class="selection-option">
        <input
          id="eq_phone"
          type="checkbox"
          onchange="actualizarCamposAsignacion()">
        Phone
      </label>

      <label class="selection-option">
        <input
          id="eq_other_equip"
          type="checkbox"
          onchange="actualizarCamposAsignacion()">
        Other equipment
      </label>
    </div>

    <div
      id="computer_details_container"
      class="assignment-detail hidden">

      <label>Computer identification <span class="optional-marker">(optional)</span></label>

      <input
        id="computer_details"
        maxlength="250"
        autocomplete="off"
        placeholder="Type to search inventory..."
        oninput="buscarInventario(this.value, 'computer_inv_result')">
      <div id="computer_inv_result" class="inv-lookup-result"></div>
    </div>

    <div
      id="phone_details_container"
      class="assignment-detail hidden">

      <label>Phone identification <span class="optional-marker">(optional)</span></label>

      <input
        id="phone_details"
        maxlength="250"
        autocomplete="off"
        placeholder="Type to search inventory..."
        oninput="buscarInventario(this.value, 'phone_inv_result')">
      <div id="phone_inv_result" class="inv-lookup-result"></div>
    </div>

    <div
      id="other_equip_container"
      class="assignment-detail hidden">

      <label>Other equipment <span class="optional-marker">(search inventory)</span></label>

      <div id="other_equip_list"></div>

      <div class="other-equip-row">
        <input
          id="other_equip_input"
          maxlength="250"
          autocomplete="off"
          placeholder="Type to search inventory..."
          oninput="buscarInventario(this.value, 'other_equip_inv_result')">
        <button type="button" class="btn-add-equip" onclick="agregarOtroEquipo()">+</button>
      </div>
      <div id="other_equip_inv_result" class="inv-lookup-result"></div>
    </div>
  </fieldset>


  <fieldset class="selection-panel">
    <legend>Additional information <span class="optional-marker">(optional)</span></legend>

    <p class="selection-help">
      Select all that apply to this employee.
    </p>

    <div class="selection-options">
      <label class="selection-option">
        <input
          id="eq_fingerprint"
          type="checkbox">
        Fingerprint registered
      </label>

      <label class="selection-option">
        <input
          id="eq_faceid"
          type="checkbox">
        Face ID registered
      </label>

      <label class="selection-option">
        <input
          id="eq_epp"
          type="checkbox">
        EPP assigned
      </label>

      <label class="selection-option">
        <input
          id="eq_parking"
          type="checkbox">
        Parking access
      </label>
    </div>

    <div class="assignment-detail">
      <label>Employee category <span class="optional-marker">(optional)</span></label>
      <select id="employee_category">
        <option value="">-- Select --</option>
        <option value="DIRECTO">Directo</option>
        <option value="INDIRECTO">Indirecto</option>
        <option value="STAFF">Staff</option>
        <option value="TEMPORAL">Temporal</option>
      </select>
    </div>
  </fieldset>
  <fieldset class="selection-panel">
    <legend>Employee access <span class="optional-marker">(optional)</span></legend>

    <p class="selection-help">
      Select all applicable access types.
    </p>

    <div class="selection-options">
      <label class="selection-option">
        <input
          type="checkbox"
          class="offboarding-access"
          value="WINDOWS">
        Windows
      </label>

      <label class="selection-option">
        <input
          type="checkbox"
          class="offboarding-access"
          value="OFFICE">
        Office
      </label>

      <label class="selection-option">
        <input
          type="checkbox"
          class="offboarding-access"
          value="SMES">
        SMES
      </label>

      <label class="selection-option">
        <input
          type="checkbox"
          class="offboarding-access"
          value="CMP">
        CMP
      </label>

      <label class="selection-option">
        <input
          type="checkbox"
          class="offboarding-access"
          value="VPN">
        VPN
      </label>

      <label class="selection-option">
        <input
          id="access_other"
          type="checkbox"
          class="offboarding-access"
          value="OTHER"
          onchange="actualizarCamposAsignacion()">
        Other
      </label>
    </div>

    <div
      id="other_access_container"
      class="assignment-detail hidden">

