async function guardarEditUsername() {
  const aviso = $('eu_aviso');

  aviso.className = 'notice';
  aviso.textContent = '';

  const id = $('eu_id').value;
  const fullName = $('eu_nombre').value.trim();
  const email = $('eu_mail').value.trim();

  const roles = Array
    .from(document.querySelectorAll('.eu_rol:checked'))
    .map(function(control) { return control.value; });

  const password = $('eu_password').value;
  const passwordConfirm = $('eu_password_confirm').value;

  if (!fullName) {
    aviso.className = 'notice error';
    aviso.textContent = 'Complete the required field: Full name.';
    return;
  }

  if (!roles.length) {
    aviso.className = 'notice error';
    aviso.textContent = 'Assign at least one profile.';
    return;
  }

  if (password || passwordConfirm) {
    if (password !== passwordConfirm) {
      aviso.className = 'notice error';
      aviso.textContent = 'Password confirmation does not match.';
      return;
    }

    if (!passwordSegura(password)) {
      aviso.className = 'notice error';
      aviso.textContent = 'Password must include uppercase, lowercase, number, and symbol.';
      return;
    }
  }

  const actualizacion = await api(
    '/api/users/' + encodeURIComponent(id),
    'PUT',
    {
      fullName: fullName,
      email: email || null,
      enabled: $('eu_enabled').checked,
      roles: roles
    }
  );

  if (actualizacion.status !== 200) {
    aviso.className = 'notice error';
    aviso.textContent =
      actualizacion.data && actualizacion.data.detail
        ? actualizacion.data.detail
        : 'Unable to update user. HTTP '
          + actualizacion.status;
    return;
  }

  if (password) {
    const cambioPassword = await api(
      '/api/users/'
        + encodeURIComponent(id)
        + '/password',
      'PUT',
      {
        password: password
      }
    );

    if (cambioPassword.status !== 204) {
      aviso.className = 'notice error';
      aviso.textContent =
        cambioPassword.data &&
        cambioPassword.data.detail
          ? cambioPassword.data.detail
          : 'Data updated, but password could not be changed. HTTP '
            + cambioPassword.status;

      await cargarUsernames();
      await cargarAudit();
      return;
    }
  }

  cerrarEditUsername();

  await cargarUsernames();
  await cargarAudit();

  alert(
    password
      ? 'User and password updated successfully.'
      : 'User updated successfully.'
  );
}


async function validarActive(taskId) {
  if (!tieneRol('ADMIN') && !tieneRol('CONTROL_ACCESOS')) {
    alert('Only an administrator or Access Control can validate this task.');
    return;
  }

  // Detectar systemName de la tarea desde la tabla
  var tareaSystem = null;
  document.querySelectorAll('tr').forEach(function(fila) {
    if (tareaSystem) return;
    var btn = fila.querySelector('button[onclick*="validarActive(' + taskId + ')"]');
    if (btn) {
      var celdas = fila.querySelectorAll('td');
      if (celdas.length > 0) {
        tareaSystem = celdas[0].textContent.replace(/\s*\*\s*$/, '').trim();
      }
    }
  });

  var ASSET_SYSTEMS = ['Equipo de c\u00f3mputo', 'Telefon\u00eda', 'Telefonia', 'Activos asignados'];
  var esActivo = ASSET_SYSTEMS.indexOf(tareaSystem) !== -1;

  var respuesta;

  if (esActivo) {
    var activoRecibido = confirm('Do you confirm that the asset was physically received?');
    if (!activoRecibido) return;

    var inventarioActualizado = confirm('Do you confirm that the inventory was updated?');
    if (!inventarioActualizado) return;

    var comentarios = prompt('Comments (optional):', 'Done');
    if (comentarios === null) return;

    respuesta = await api(
      '/api/tasks/' + encodeURIComponent(taskId) + '/validate',
      'PATCH',
      {
        assetReceived: true,
        inventoryUpdated: true,
        inventoryReference: comentarios.trim() || 'Validated',
        validationComments: comentarios.trim() || null
      }
    );
  } else {
    var confirmado = confirm('Do you confirm this task has been validated?');
    if (!confirmado) return;

    respuesta = await api(
      '/api/tasks/' + encodeURIComponent(taskId) + '/validate',
      'PATCH',
      {
        assetReceived: true,
        inventoryUpdated: true,
        inventoryReference: 'Validated',
        validationComments: null
      }
    );
  }

  if (respuesta.status === 200) {
    alert('Task validated successfully.');
    await cargarCases();
    await cargarAudit();
  }
  else {
    alert(
      respuesta.data && respuesta.data.detail
        ? respuesta.data.detail
        : 'Unable to validate the task. HTTP ' + respuesta.status
    );
  }
}


async function recargar() {
  const tareas = [];

  if (
    tieneRol('ADMIN') ||
    tieneRol('IT_ENGINEER') ||
    tieneRol('AUDITOR') ||
    tieneRol('CONTROL_ACCESOS')
  ) {
    tareas.push(cargarCases());
  }

  if (
    tieneRol('ADMIN') ||
    tieneRol('AUDITOR')
  ) {
    tareas.push(cargarAudit());
  }

  if (tieneRol('ADMIN')) {
    tareas.push(cargarUsernames());
    tareas.push(cargarDestinatarios());
  }

  await Promise.all(tareas);
}


async function buscarEmpleado() {
  const campo = $('idf');
  const numero = (campo.value || '').trim();
  const status = $('idf_status');
  const autoCampos = ['n', 'dep', 'work_area', 'jefe'];

  if (!numero) {
    if (status) status.innerHTML = '';
    autoCampos.forEach(function(id) {
      $(id).style.backgroundColor = '';
      $(id).readOnly = false;
    });
    return;
  }

  if (isNaN(numero)) {
    if (status) status.innerHTML = '<span style="color:#a52314">Enter a numeric employee number</span>';
    return;
  }

  if (status) status.innerHTML = '<span style="color:#5a6b7f">Searching...</span>';

  try {
    const resp = await api('/api/premployees/by-num/' + encodeURIComponent(numero));

    if (resp.status === 200 && resp.data) {
      const emp = resp.data;
      $('n').value        = emp.employeeName || '';
      $('dep').value       = emp.deptName  || emp.deptCode      || '';
      $('work_area').value = emp.areaName  || emp.areaCode    || '';
      $('jefe').value      = emp.superName || emp.superCode || '';

      autoCampos.forEach(function(id) {
        $(id).style.backgroundColor = '#eef6ed';
        $(id).readOnly = true;
      });

      if (status) status.innerHTML = '<span style="color:#146c42">&#10003; ' + esc(emp.employeeName) + '</span>';
      log('Employee ' + numero + ' found: ' + (emp.employeeName || '-'));
    } else {
      autoCampos.forEach(function(id) {
        $(id).style.backgroundColor = '';
        $(id).readOnly = false;
      });
      if (status) status.innerHTML = '<span style="color:#a86e00">Not found - fill fields manually</span>';
      log('Employee ' + numero + ' not found in premployee.', 'warn');
    }
  } catch (e) {
    autoCampos.forEach(function(id) {
      $(id).style.backgroundColor = '';
      $(id).readOnly = false;
    });
    if (status) status.innerHTML = '<span style="color:#a52314">Connection error</span>';
    log('Error looking up employee: ' + e.message, 'err');
  }
}

function setDefaultFecha() {
  const campo = $('fecha');
  if (campo && !campo.value) {
    const ahora = new Date();
    ahora.setMinutes(ahora.getMinutes() - ahora.getTimezoneOffset());
    campo.value = ahora.toISOString().slice(0, 16);
  }
}

async function iniciar() {
  actualizarIndicadorSemana();
  limpiarCaptura();
  setDefaultFecha();

  const sesionValida = await cargarSesion();

  if (!sesionValida) {
    return;
  }

  await recargar();
}

iniciar();



/* ============================================================
   NOTIFICATION RECIPIENTS (admin only)
   ============================================================ */

let destinatariosData = [];

async function cargarDestinatarios() {
  const resp = await api('/api/notification-recipients');
  const tabla = $('tabla_destinatarios');

  if (resp.status !== 200) {
    tabla.innerHTML =
      '<tr><td colspan="5">Unable to load recipients. HTTP ' + resp.status + '</td></tr>';
    return;
  }

  destinatariosData = Array.isArray(resp.data) ? resp.data : [];

  if (!destinatariosData.length) {
    tabla.innerHTML =
      '<tr><td colspan="5" class="empty-row">No recipients configured. Notifications will not be sent.</td></tr>';
    return;
  }

  tabla.innerHTML = destinatariosData.map(function(r) {
    return '<tr>' +
      '<td>' + r.id + '</td>' +
      '<td><b>' + esc(r.email) + '</b></td>' +
      '<td>' + esc(r.description || '-') + '</td>' +
      '<td>' + (r.active
        ? '<span class="pill VALIDADA">ACTIVE</span>'
        : '<span class="pill CRITICO">INACTIVE</span>') + '</td>' +
      '<td class="user-actions">' +
        '<button type="button" class="mini" onclick="toggleDestinatario(' + r.id + ',' + r.active + ')">' +
          (r.active ? 'Disable' : 'Enable') +
        '</button>' +
        '<button type="button" class="mini logout" onclick="eliminarDestinatario(' + r.id + ')">Delete</button>' +
      '</td>' +
    '</tr>';
  }).join('');
}

async function crearDestinatario() {
  var aviso = $('nr_aviso');
  aviso.textContent = '';

  var email = $('nr_email').value.trim();
  if (!email) {
    aviso.textContent = 'Email is required.';
    return;
  }

  var desc = $('nr_desc').value.trim();

  var resp = await api('/api/notification-recipients', 'POST', {
    email: email,
    description: desc || null,
    active: true
  });

  if (resp.status === 201) {
    $('nr_email').value = '';
    $('nr_desc').value = '';
    await cargarDestinatarios();
    await cargarAudit();
  } else {
    aviso.textContent = resp.data && resp.data.detail
      ? resp.data.detail
      : 'Unable to add recipient. HTTP ' + resp.status;
  }
}

async function toggleDestinatario(id, currentActive) {
  var r = destinatariosData.find(function(x) { return x.id === id; });
  if (!r) return;

  var resp = await api('/api/notification-recipients/' + id, 'PUT', {
    email: r.email,
    description: r.description,
    active: !currentActive
  });

  if (resp.status === 200) {
    await cargarDestinatarios();
    await cargarAudit();
  } else {
    alert(resp.data && resp.data.detail
      ? resp.data.detail
      : 'Unable to update recipient.');
  }
}

async function eliminarDestinatario(id) {
  if (!confirm('Remove this recipient permanently?')) return;

  var resp = await api('/api/notification-recipients/' + id, 'DELETE');

  if (resp.status === 204) {
    await cargarDestinatarios();
    await cargarAudit();
  } else {
    alert(resp.data && resp.data.detail
      ? resp.data.detail
      : 'Unable to delete recipient.');
  }
}

setInterval(function() {
  recargar();
}, 15000);
