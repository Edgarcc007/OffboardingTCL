<script>
(function () {
  const exactTranslations = {
    'RENUNCIA': 'Resignation',
    'DESPIDO': 'Termination',
    'FIN_DE_CONTRATO': 'End of contract',
    'JUBILACION': 'Retirement',
    'MUTUO_ACUERDO': 'Mutual agreement',
    'FALLECIMIENTO': 'Deceased',
    'NO_ESPECIFICADO': 'Not specified',

    'BAJO': 'Low',
    'NORMAL': 'Normal',
    'ALTO': 'High',
    'CRITICO': 'Critical',

    'PROGRAMADA': 'Scheduled',
    'EN_PROCESO': 'In progress',
    'COMPLETADA': 'Completed',
    'VALIDADA': 'Validated',
    'REABIERTA': 'Reopened',
    'NO_APLICA': 'Not applicable',
    'PENDIENTE': 'Pending',

    'ACTIVO': 'Active',
    'INACTIVO': 'Inactive',

    'RECURSOS HUMANOS': 'Human Resources',
    'CONTROL_ACCESOS': 'Access Control',

    'CREADO': 'Created',
    'ACTUALIZADO': 'Updated',
    'COMPLETADO': 'Completed',
    'REABIERTO': 'Reopened'
  };

  const phraseTranslations = [
    ['Baja registrada correctamente.', 'Offboarding registered successfully.'],
    ['Completa los campos obligatorios:', 'Complete the required fields:'],
    ['Error registrando la baja.', 'Error registering the offboarding.'],
    ['No fue posible cargar', 'Unable to load'],
    ['No fue posible localizar', 'Unable to locate'],
    ['Usuario creado correctamente.', 'User created successfully.'],
    ['Usuario actualizado correctamente.', 'User updated successfully.'],
    ['Contrase\u00f1a actualizada correctamente.', 'Password updated successfully.']
  ];

  function translateVisibleText(value) {
    if (!value) {
      return value;
    }

    const trimmed = value.trim();

    if (exactTranslations[trimmed]) {
      return value.replace(
        trimmed,
        exactTranslations[trimmed]
      );
    }

    let translated = value;

    for (const translation of phraseTranslations) {
      translated = translated.replace(
        translation[0],
        translation[1]
      );
    }

    return translated;
  }

  function translateNode(node) {
    if (!node) {
      return;
    }

    if (node.nodeType === Node.TEXT_NODE) {
      const parent = node.parentElement;

      if (
        !parent
        || parent.matches(
          'script, style, input, textarea, option'
        )
      ) {
        return;
      }

      const translated =
        translateVisibleText(node.nodeValue);

      if (translated !== node.nodeValue) {
        node.nodeValue = translated;
      }

      return;
    }

    if (node.nodeType !== Node.ELEMENT_NODE) {
      return;
    }

    if (node.matches('script, style')) {
      return;
    }

    for (
      const child
      of node.childNodes
    ) {
      translateNode(child);
    }
  }

  translateNode(document.body);

  const observer = new MutationObserver(
    function(mutations) {
      for (const mutation of mutations) {
        if (
          mutation.type === 'characterData'
        ) {
          translateNode(mutation.target);
          continue;
        }

        for (
          const addedNode
          of mutation.addedNodes
        ) {
          translateNode(addedNode);
        }
      }
    }
  );

  observer.observe(
    document.body,
    {
      childList: true,
      subtree: true,
      characterData: true
    }
  );
})();
</script>

