async function cargarAudit() {
  const respuesta = await api('/api/audit');

  if (respuesta.status !== 200) {
    $('audit').innerHTML =
      '<tr><td colspan="7">Unable to load audit log. HTTP ' + respuesta.status + '</td></tr>';
    return;
  }

  const eventos = Array.isArray(respuesta.data)
    ? respuesta.data
    : [];

  const contador = $('audit_count');

  if (contador) {
    contador.textContent =
      eventos.length +
      (eventos.length === 1
        ? ' event'
        : ' events');
  }

  if (!eventos.length) {
    $('audit').innerHTML =
      '<tr><td colspan="7" class="empty-row">No audit events.</td></tr>';
    return;
  }

  $('audit').innerHTML = eventos.map(function(evento) {
    return '<tr>' +
      '<td>' + evento.id + '</td>' +
      '<td><span class="pill NORMAL">' + textoSemanaISO(evento.occurredAt) + '</span></td>' +
      '<td>' + new Date(evento.occurredAt).toLocaleString() + '</td>' +
      '<td><b>' + esc(evento.actor) + '</b></td>' +
      '<td>' + esc(evento.action) + '</td>' +
      '<td>' + esc(evento.entityType) + ' #' + (evento.entityId == null ? '-' : evento.entityId) + '</td>' +
      '<td>' + esc(evento.details) + '</td>' +
    '</tr>';
  }).join('');
}

