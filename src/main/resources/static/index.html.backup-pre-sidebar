async function reabrir(id) {
  if (!tieneRol('ADMIN')) {
    return;
  }

  const motivo = prompt(
    'Enter the reason to reopen this task:',
    ''
  );

  if (motivo === null) {
    return;
  }

  const motivoLimpio = motivo.trim();

  if (motivoLimpio.length < 5) {
    alert(
      'The reason must be at least 5 characters.'
    );

    return;
  }

  const confirmar = confirm(
    'The task will return to PENDING status.\n\n' +
    'It will need to be processed again.\n\n' +
    'Do you want to continue?'
  );

  if (!confirmar) {
    return;
  }

  const respuesta = await api(
    '/api/tasks/' + id + '/reopen',
    'PATCH',
    {
      reason: motivoLimpio
    }
  );

  if (respuesta.status === 200) {
    log(
      'Task ' + id +
      ' reopened successfully by ADMIN.'
    );
  }
  else {
    const detalle =
      respuesta.data &&
      (
        respuesta.data.detail ||
        respuesta.data.message
      );

    log(
      detalle ||
      (
        'Unable to reopen task ' +
        id +
        '. HTTP ' +
        respuesta.status
      ),
      'err'
    );
  }

  await recargar();
}

async function validar(id) {
  if (!tieneRol('ADMIN') && !tieneRol('CONTROL_ACCESOS')) {
    return;
  }

  const respuesta = await api(
    '/api/tasks/' + id + '/validate',
    'PATCH'
  );

  if (respuesta.status === 200) {
    log(
      'Task ' + id + ' validated by ' + respuesta.data.validatedBy
    );
  }
  else if (respuesta.status === 403) {
    log(
      'Validation must be performed by a different person than the one who completed the task.',
      'warn'
    );
  }
  else {
    log(
      'Error validating task ' + id + ': HTTP ' + respuesta.status,
      'err'
    );
  }

  await recargar();
}

