<script>
/* ============================================================
   INVENTORY LOOKUP  +  CLEAR FORM BUTTON
   ============================================================ */
(function () {

  /* ---------- inventory data cache ---------- */
  var _inventoryData = null;
  var _inventoryLoading = false;
  var _inventoryCallbacks = [];

  function loadInventory(cb) {
    if (_inventoryData) { cb(_inventoryData); return; }
    _inventoryCallbacks.push(cb);
    if (_inventoryLoading) return;
    _inventoryLoading = true;

    fetch('/inventory.json')
      .then(function (r) { return r.json(); })
      .then(function (data) {
        _inventoryData = Array.isArray(data) ? data : [];
        _inventoryCallbacks.forEach(function (fn) { fn(_inventoryData); });
        _inventoryCallbacks = [];
      })
      .catch(function () {
        _inventoryData = [];
        _inventoryCallbacks.forEach(function (fn) { fn([]); });
        _inventoryCallbacks = [];
      });
  }

  /* ---------- search helper ---------- */
  function searchInventory(query, items) {
    var q = (query || '').trim().toLowerCase();
    if (!q || q.length < 2) return [];

    return items.filter(function (item) {
      return (
        (item.tag    && item.tag.toLowerCase().indexOf(q) !== -1) ||
        (item.id     && item.id.toLowerCase().indexOf(q) !== -1) ||
        (item.serial && item.serial.toLowerCase().indexOf(q) !== -1) ||
        (item.model  && item.model.toLowerCase().indexOf(q) !== -1) ||
        (item.user   && item.user.toLowerCase().indexOf(q) !== -1)
      );
    }).slice(0, 8);
  }

  /* ---------- render a result tag ---------- */
  function statusClass(s) {
    if (!s) return 'other';
    var l = s.toLowerCase();
    if (l === 'on use' || l.indexOf('activ') !== -1 || l.indexOf('asigna') !== -1) return 'on-use';
    if (l.indexOf('inactiv') !== -1 || l.indexOf('baja') !== -1 || l.indexOf('decomm') !== -1) return 'inactive';
    if (l.indexOf('available') !== -1 || l.indexOf('disponible') !== -1) return 'available';
    return 'other';
  }

  function renderTag(item) {
    return '<span class="inv-tag found">' +
      '<span class="inv-icon">&#9989;</span>' +
      '<span class="inv-field">' + esc(item.tag || item.id || '-') + '</span>' +
      '<span class="inv-sep">|</span>' +
      esc(item.model || '-') +
      '<span class="inv-sep">|</span>' +
      esc(item.serial || '-') +
      '<span class="inv-sep">|</span>' +
      esc(item.user || '-') +
      '<span class="inv-sep">|</span>' +
      '<span class="inv-tag-status ' + statusClass(item.status) + '">' + esc(item.status || '-') + '</span>' +
    '</span>';
  }

  function renderNotFound(query) {
    return '<span class="inv-tag not-found">' +
      '<span class="inv-icon">&#9888;</span>' +
      ' No match for "<b>' + esc(query) + '</b>"' +
    '</span>';
  }

  /* ---------- global buscarInventario ---------- */
  window.buscarInventario = function (value, resultContainerId) {
    var container = document.getElementById(resultContainerId);
    if (!container) return;

    var q = (value || '').trim();
    if (q.length < 2) { container.innerHTML = ''; return; }

    loadInventory(function (items) {
      var results = searchInventory(q, items);
      if (results.length === 0) {
        container.innerHTML = renderNotFound(q);
      } else if (results.length === 1) {
        container.innerHTML = renderTag(results[0]);
      } else {
        // Show clickable list
        container.innerHTML = results.map(function (item, idx) {
          return '<div class="inv-result-option" data-idx="' + idx + '" ' +
            'style="cursor:pointer;padding:4px 8px;border-bottom:1px solid #eee;font-size:.82rem" ' +
            'onmouseenter="this.style.background=\'#e3f2fd\'" ' +
            'onmouseleave="this.style.background=\'\'">' +
            '<b>' + esc(item.tag || item.id || '-') + '</b> &mdash; ' +
            esc(item.model || '') + ' &mdash; ' +
            esc(item.user || '') + ' &mdash; ' +
            '<span class="inv-tag-status ' + statusClass(item.status) + '">' + esc(item.status || '-') + '</span>' +
          '</div>';
        }).join('');

        // Click to select
        container.querySelectorAll('.inv-result-option').forEach(function (el) {
          el.addEventListener('click', function () {
            var i = parseInt(el.getAttribute('data-idx'));
            var selected = results[i];
            if (!selected) return;

            // Find the input that triggered this
            var input = container.previousElementSibling;
            while (input && input.tagName !== 'INPUT') {
              input = input.previousElementSibling;
            }
            if (input) {
              input.value = selected.tag || selected.id || '';
            }
            container.innerHTML = renderTag(selected);
          });
        });
      }
    });
  };

  /* ---------- Other equipment list ---------- */
  window._otherEquipItems = window._otherEquipItems || [];

  window.renderOtherEquipList = function () {
    var list = document.getElementById('other_equip_list');
    if (!list) return;

    if (!window._otherEquipItems.length) {
      list.innerHTML = '';
      return;
    }

    list.innerHTML = window._otherEquipItems.map(function (text, idx) {
      return '<div class="other-equip-item">' +
        '<span class="equip-info">' + esc(text) + '</span>' +
        '<button type="button" class="btn-remove-equip" onclick="removeOtherEquip(' + idx + ')">&times;</button>' +
      '</div>';
    }).join('');
  };

  window.agregarOtroEquipo = function () {
    var input = document.getElementById('other_equip_input');
    if (!input) return;
    var val = input.value.trim();
    if (!val) return;

    window._otherEquipItems.push(val);
    input.value = '';
    var r = document.getElementById('other_equip_inv_result');
    if (r) r.innerHTML = '';
    window.renderOtherEquipList();
  };

  window.removeOtherEquip = function (idx) {
    window._otherEquipItems.splice(idx, 1);
    window.renderOtherEquipList();
  };

  /* ---------- CLEAR FORM BUTTON ---------- */
  var captureSection = document.getElementById('seccion_captura');
  if (captureSection) {
    // Find the "Register offboarding" button
    var registerBtn = captureSection.querySelector('button[onclick="crearCase()"]');
    if (registerBtn) {
      var clearBtn = document.createElement('button');
      clearBtn.type = 'button';
      clearBtn.textContent = 'Clear form';
      clearBtn.style.cssText = 'background:#6b7280;margin-left:10px';
      clearBtn.onmouseover = function () { clearBtn.style.background = '#4b5563'; };
      clearBtn.onmouseout = function () { clearBtn.style.background = '#6b7280'; };
      clearBtn.onclick = function () {
        limpiarCaptura();
        setDefaultFecha();
        // Also clear inventory results
        ['computer_inv_result', 'phone_inv_result', 'other_equip_inv_result'].forEach(function (id) {
          var el = document.getElementById(id);
          if (el) el.innerHTML = '';
        });
        window._otherEquipItems = [];
        window.renderOtherEquipList();
      };
      registerBtn.parentNode.insertBefore(clearBtn, registerBtn.nextSibling);
    }
  }

  /* ---------- helper (reuse from main script) ---------- */
  function esc(v) {
    return (v == null ? '' : String(v))
      .replace(/[<>&]/g, function (c) {
        return { '<': '&lt;', '>': '&gt;', '&': '&amp;' }[c];
      });
  }

})();
</script>
