  else {
    resultado.className = 'notice error';
    resultado.textContent =
      respuesta.data && respuesta.data.detail
        ? respuesta.data.detail
        : 'Error registering the offboarding. HTTP '
          + respuesta.status;
  }
}


function generarPass() {
  const mayusculas = 'ABCDEFGHJKLMNPQRSTUVWXYZ';
  const minusculas = 'abcdefghijkmnopqrstuvwxyz';
  const numeros = '23456789';
  const simbolos = '#$%&*+-';
  const todos = mayusculas + minusculas + numeros + simbolos;

  let password = '';

  password += mayusculas[Math.floor(Math.random() * mayusculas.length)];
  password += minusculas[Math.floor(Math.random() * minusculas.length)];
  password += numeros[Math.floor(Math.random() * numeros.length)];
  password += simbolos[Math.floor(Math.random() * simbolos.length)];

  for (let i = 0; i < 12; i++) {
    password += todos[Math.floor(Math.random() * todos.length)];
  }

  $('nu_pass').type = 'text';
  $('nu_pass').value = password;
}

async function crearUsername() {
  if (!tieneRol('ADMIN')) {
    return;
  }

  const roles = Array
    .from(document.querySelectorAll('.rol:checked'))
    .map(function(control) { return control.value; });

  const aviso = $('nu_aviso');
  aviso.textContent = '';

  const username = $('nu_user').value.trim();
  const fullName = $('nu_nombre').value.trim();
  const email = $('nu_mail').value.trim();
  const password = $('nu_pass').value;

  const missingFields = [];

  if (!username) { missingFields.push('Username'); }
  if (!fullName) { missingFields.push('Full name'); }
  if (!password) { missingFields.push('Temporary password'); }
  if (!roles.length) { missingFields.push('Profiles'); }

  if (missingFields.length) {
    aviso.textContent =
      'Complete the required fields: '
      + missingFields.join(', ')
      + '.';
    return;
  }

  if (
    typeof passwordSegura === 'function'
    && !passwordSegura(password)
  ) {
    aviso.textContent =
      'Password must contain 12 to 100 characters, including an uppercase letter, lowercase letter, number, and symbol.';
    return;
  }

  const respuesta = await api(
    '/api/users',
    'POST',
    {
      username: username,
      fullName: fullName,
      email: email || null,
      password: password,
      roles: roles
    }
  );

  if (respuesta.status === 201) {
    alert(
      'User created successfully.\n\n'
      + 'Username: ' + username + '\n'
      + 'Password: ' + password + '\n\n'
      + 'This password will not be shown again.'
    );

    $('nu_user').value = '';
    $('nu_nombre').value = '';
    $('nu_mail').value = '';
    $('nu_pass').value = '';
    $('nu_pass').type = 'password';

    document
      .querySelectorAll('.rol:checked')
      .forEach(function(control) {
        control.checked = false;
      });

    await cargarUsernames();
    await cargarAudit();
  }
  else {
    aviso.textContent =
      respuesta.data && respuesta.data.detail
        ? respuesta.data.detail
        : 'Unable to create user. HTTP '
          + respuesta.status;
  }
}


