    { id: 'n', label: 'Employee name' },
    { id: 'idf', label: 'Employee number or identifier' },
    { id: 'dep', label: 'Department' },
    { id: 'work_area', label: 'Work area' },
    { id: 'jefe', label: 'Direct manager' },
    { id: 'riesgo', label: 'Risk level' }
  ];

  const missingFields =
    requiredFields.filter(function(field) {
      var control = $(field.id);
      return !String(control.value || '').trim();
    });

  if (missingFields.length) {
    resultado.className = 'notice error';
    resultado.textContent =
      'Complete the required fields: '
      + missingFields
          .map(function(field) { return field.label; })
          .join(', ')
      + '.';

    var firstControl = $(missingFields[0].id);
    firstControl.focus();
    firstControl.scrollIntoView({
      behavior: 'smooth',
      block: 'center'
    });

    return;
  }

  const corporateEmail = $('mail').value.trim();
  const fecha = $('fecha').value;
  const accesosSeleccionados = obtenerAccesosSeleccionados();

  const solicitud = {
    employeeName: $('n').value.trim(),
    employeeIdentifier: $('idf').value.trim(),
    corporateEmail: corporateEmail || null,
    department: $('dep').value.trim(),
    building: $('building').value.trim() || null,
    workArea: $('work_area').value.trim(),
    managerName: $('jefe').value.trim(),
    terminationType: $('tipo').value || 'NO_ESPECIFICADO',
    effectiveAt: fecha
      ? new Date(fecha).toISOString()
      : new Date().toISOString(),
    riskLevel: $('riesgo').value || 'NORMAL',
    confidential: $('conf').value === 'true',
    computerAssigned: $('eq_computer').checked,
    computerDetails: $('computer_details').value.trim() || null,
    phoneAssigned: $('eq_phone').checked,
    phoneDetails: $('phone_details').value.trim() || null,
    fingerprintRegistered: $('eq_fingerprint').checked,
    faceidRegistered: $('eq_faceid').checked,
    eppAssigned: $('eq_epp').checked,
    parkingAccess: $('eq_parking').checked,
    employeeCategory: $('employee_category').value.trim() || null,
    accesses: accesosSeleccionados,
    otherAccesses: (function(){
