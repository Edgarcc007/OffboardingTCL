<script>
const $ = id => document.getElementById(id);

let rolesActuales = new Set();
let usuarioActual = '';


function obtenerSemanaISO(valor) {
  const fecha = valor
    ? new Date(valor)
    : new Date();

  const fechaUTC = new Date(
    Date.UTC(
      fecha.getFullYear(),
      fecha.getMonth(),
      fecha.getDate()
    )
  );

  const dia = fechaUTC.getUTCDay() || 7;

  fechaUTC.setUTCDate(
    fechaUTC.getUTCDate() + 4 - dia
  );

  const inicioAnio = new Date(
    Date.UTC(
      fechaUTC.getUTCFullYear(),
      0,
      1
    )
  );

  const semana = Math.ceil(
    (
      (
        fechaUTC -
        inicioAnio
      ) / 86400000 + 1
    ) / 7
  );

  return {
    week: semana,
    year: fechaUTC.getUTCFullYear()
  };
}

function textoSemanaISO(valor) {
  const resultado = obtenerSemanaISO(valor);

  return 'S' +
    String(resultado.week).padStart(2, '0') +
    ' \u00b7 ' +
    resultado.year;
}

function actualizarIndicadorSemana() {
  const resultado = obtenerSemanaISO();

  const indicador = $('week_indicator');

  if (!indicador) {
    return;
  }

  indicador.textContent =
    'Week ' +
    resultado.week +
    ' \u00b7 ' +
    resultado.year;
}

function toggleAuditoria() {
  const seccion = $('seccion_auditoria');
  const cuerpo = $('audit_body');
  const boton = $('btn_audit_toggle');

  if (!seccion || !cuerpo || !boton) {
    return;
  }

  const expandir = cuerpo.classList.contains('hidden');

  cuerpo.classList.toggle(
    'hidden',
    !expandir
  );

  seccion.classList.toggle(
    'expanded',
    expandir
  );

  boton.setAttribute(
    'aria-expanded',
    expandir ? 'true' : 'false'
  );

  boton.setAttribute(
    'title',
    expandir
      ? 'Collapse audit log'
      : 'Expand audit log'
  );
}


function tieneRol(rol) {
  return rolesActuales.has(rol);
}

function mostrar(id, visible) {
  const elemento = $(id);

  if (!elemento) {
    return;
  }

  elemento.classList.toggle('hidden', !visible);
}

function esc(valor) {
  return (valor == null ? '' : String(valor))
    .replace(/[<>&]/g, caracter => ({
      '<': '&lt;',
      '>': '&gt;',
      '&': '&amp;'
    }[caracter]));
}

function log(mensaje, clase) {
  const contenedor = $('log');

  if (!contenedor) {
    return;
  }

  const linea = document.createElement('div');

  if (clase) {
    linea.className = clase;
  }

  linea.textContent =
    new Date().toLocaleTimeString() + '  ' + mensaje;

  contenedor.prepend(linea);
}

async function api(path, method, body) {
  const respuesta = await fetch(path, {
    method: method || 'GET',
    headers: {
      'Content-Type': 'application/json'
    },
    body: body ? JSON.stringify(body) : undefined
  });

  if (respuesta.status === 401) {
    window.location.replace('/login.html?expired');

    return {
      status: 401,
      data: null
    };
  }

  let data = null;

  try {
    data = await respuesta.json();
  }
  catch (error) {
    data = null;
  }

  return {
    status: respuesta.status,
    data: data
  };
}


function claveRegistrosRH() {
  const usuario = usuarioActual || 'desconocido';

  return 'offboarding.rh.session.' + usuario.toLowerCase();
}

function obtenerRegistrosRH() {
  try {
    const contenido = sessionStorage.getItem(
      claveRegistrosRH()
    );

    if (!contenido) {
      return [];
    }

    const registros = JSON.parse(contenido);

    return Array.isArray(registros)
      ? registros
      : [];
  }
  catch (error) {
    console.error(
      'Unable to read RH records',
      error
    );

    return [];
  }
}

function guardarRegistrosRH(registros) {
  try {
    sessionStorage.setItem(
      claveRegistrosRH(),
      JSON.stringify(registros)
    );
  }
  catch (error) {
    console.error(
      'Unable to save RH records',
      error
    );
  }
}

function agregarRegistroRH(caso, solicitud) {
  if (!tieneRol('RECURSOS_HUMANOS')) {
    return;
  }

  const registros = obtenerRegistrosRH();

  registros.unshift({
    registeredAt: new Date().toISOString(),
    caseNumber: caso.caseNumber || '-',
    employeeName: solicitud.employeeName || '-',
    employeeIdentifier:
      solicitud.employeeIdentifier || '-',
    department: solicitud.department || '-',
    building: solicitud.building || '-',
    workArea: solicitud.workArea || '-',
    terminationType:
      solicitud.terminationType || '-',
    effectiveAt:
      solicitud.effectiveAt || null,
    status: caso.status || 'REGISTRADA'
  });

  guardarRegistrosRH(
    registros.slice(0, 100)
  );

  renderizarRegistrosRH();
}

function renderizarRegistrosRH() {
  const tabla = $('tabla_registros_rh');

  if (!tabla) {
    return;
  }

  const registros = obtenerRegistrosRH();

  if (!registros.length) {
    tabla.innerHTML = '<tr><td colspan="10" class="empty-row">No offboardings registered in this session yet.</td></tr>';
    return;
  }

  tabla.innerHTML = registros.map(registro => '<tr>' +
    '<td>' + new Date(registro.registeredAt).toLocaleTimeString() + '</td>' +
    '<td><b>' + esc(registro.caseNumber) + '</b></td>' +
    '<td>' + esc(registro.employeeName) + '</td>' +
    '<td>' + esc(registro.employeeIdentifier) + '</td>' +
    '<td>' + esc(registro.department) + '</td>' +
    '<td>' + esc(registro.building || '-') + '</td>' +
    '<td>' + esc(registro.workArea || '-') + '</td>' +
    '<td>' + esc(registro.terminationType) + '</td>' +
    '<td>' + (registro.effectiveAt ? new Date(registro.effectiveAt).toLocaleString() : '-') + '</td>' +
    '<td><span class="pill ' + esc(registro.status) + '">' + esc(registro.status) + '</span></td>' +
    '</tr>'
  ).join('');
}


function nombrePerfil() {
  if (tieneRol('ADMIN')) {
    return 'Administrator';
  }

  if (tieneRol('RECURSOS_HUMANOS')) {
    return 'Human Resources \u2014 capture only';
  }

  if (tieneRol('IT_ENGINEER')) {
    return 'IT Engineer \u2014 task processing';
  }

  if (tieneRol('CONTROL_ACCESOS')) {
    return 'Access Control \u2014 biometrics and physical access';
  }

  if (tieneRol('AUDITOR')) {
    return 'Auditor \u2014 read-only';
  }

  return 'No authorized profile';
}

function aplicarPermisos() {
  const esAdmin = tieneRol('ADMIN');
  const esRH = tieneRol('RECURSOS_HUMANOS');
  const esEngineer = tieneRol('IT_ENGINEER');
  const esAuditor = tieneRol('AUDITOR');
  const esControlAccesos = tieneRol('CONTROL_ACCESOS');

  const tienePerfil =
    esAdmin ||
    esRH ||
    esEngineer ||
    esAuditor ||
    esControlAccesos;

  mostrar('perfil_actual', true);
  $('perfil_actual').textContent = nombrePerfil();

  mostrar('sin_permisos', !tienePerfil);
  mostrar('seccion_captura', esAdmin || esRH);

  mostrar(
    'seccion_registros_rh',
    esRH && !esAdmin
  );

  mostrar('seccion_usuarios', esAdmin);
  mostrar('seccion_destinatarios', esAdmin);
  mostrar('seccion_casos', esAdmin || esEngineer || esAuditor || esControlAccesos);
  mostrar('seccion_auditoria', esAdmin || esAuditor);
  mostrar('seccion_log', esAdmin || esEngineer || esControlAccesos);

  mostrar(
    'btn_recargar',
    esAdmin || esEngineer || esAuditor || esControlAccesos
  );

  if (esControlAccesos && !esAdmin && !esEngineer) {
    $('titulo_casos').textContent =
      'Tasks \u2014 Access Control';
  }
  else if (esAuditor && !esAdmin) {
    $('titulo_casos').textContent =
      'Tasks \u2014 read-only';
  }
  else if (esEngineer && !esAdmin) {
    $('titulo_casos').textContent =
      'Tasks \u2014 IT Engineer';
  }
  else {
    $('titulo_casos').textContent =
      'Tasks';
  }
}

async function cargarSesion() {
  const respuesta = await api('/api/auth/me');

  if (respuesta.status !== 200 || !respuesta.data) {
    return false;
  }

  usuarioActual =
    respuesta.data.username || 'Username';

  $('usuario_actual').textContent =
    usuarioActual;

  const roles = Array.isArray(respuesta.data.roles)
    ? respuesta.data.roles
    : [];

  rolesActuales = new Set(roles);

  $('roles_actuales').textContent = roles.length
    ? 'Profiles: ' + roles.join(', ')
    : 'No assigned profiles';

  aplicarPermisos();
  renderizarRegistrosRH();

  return true;
}


/* ---- Sistemas que Control de Accesos puede gestionar ---- */
const ACCESS_CONTROL_SYSTEMS = new Set([
  'Accesos fisicos',
  'Accesos f\u00edsicos',
  'Control de accesos',
  'Biom\u00e9tricos'
]);

function esTaskDeControlAccesos(tarea) {
  return ACCESS_CONTROL_SYSTEMS.has(tarea.systemName);
}


function accionesTask(tarea) {
  const esAdmin = tieneRol('ADMIN');
  const esEngineer = tieneRol('IT_ENGINEER');
  const esControlAccesos = tieneRol('CONTROL_ACCESOS');

  const puedeCompletarGeneral = esAdmin || esEngineer;
  const puedeCompletarAccesos = esControlAccesos && esTaskDeControlAccesos(tarea);
  const puedeComplete = puedeCompletarGeneral || puedeCompletarAccesos;

  const puedeValidarGeneral = esAdmin;
  const puedeValidarAccesos = esControlAccesos && esTaskDeControlAccesos(tarea);
  const puedeValidar = puedeValidarGeneral || puedeValidarAccesos;

  const botones = [];

  if (puedeComplete && tarea.status === 'PENDIENTE') {
    botones.push(
      '<button class="mini ok" onclick="completar(' + tarea.id + ')">Complete</button>'
    );
  }

  if (
    puedeValidar &&
    tarea.critical &&
    tarea.status === 'COMPLETADA'
  ) {
    botones.push(
      '<button class="mini val" onclick="validarActive(' + tarea.id + ')">Validate</button>'
    );
  }

  if (
    esAdmin &&
    (
      tarea.status === 'COMPLETADA' ||
      tarea.status === 'VALIDADA' ||
      tarea.status === 'NO_APLICA'
    )
  ) {
    botones.push(
      '<button class="mini reopen" onclick="reabrir(' + tarea.id + ')">Reopen</button>'
    );
  }

  return botones.length
    ? botones.join('')
    : '<span style="color:#78899b">Read-only</span>';
}

function toggleCase(id) {
  const caso = document.getElementById(
    'caso-' + id
  );

  if (!caso) {
    return;
  }

  const expandido =
    caso.classList.toggle('expanded');

  const boton = caso.querySelector('.case-toggle');

  if (boton) {
    boton.setAttribute(
      'aria-expanded',
      expandido ? 'true' : 'false'
    );

    boton.setAttribute(
      'title',
      expandido
        ? 'Collapse case'
        : 'Expand case'
    );
  }
}

async function cargarCases() {
  const casosAbiertos = new Set(
    Array.from(
      document.querySelectorAll('.caso.expanded')
    ).map(elemento => elemento.dataset.caseId)
  );

  const respuesta = await api('/api/offboardings');

  if (respuesta.status !== 200) {
    $('casos').innerHTML =
      'Unable to load cases. HTTP ' +
      respuesta.status;

    log(
      'GET /api/offboardings -> ' + respuesta.status,
      'err'
    );

    return;
  }

  if (!respuesta.data.length) {
    $('casos').innerHTML =
      'No cases registered.';

    return;
  }

  $('casos').innerHTML = respuesta.data.map(function(caso) {
    var tareas = (caso.tasks || [])
      .sort(function(a, b) { return a.id - b.id; });

    var tareasPendientes = tareas.filter(
      function(tarea) { return tarea.status === 'PENDIENTE'; }
    ).length;

    var estaAbierto = casosAbiertos.has(
      String(caso.id)
    );

    return '<div id="caso-' + caso.id + '" data-case-id="' + caso.id + '" class="caso ' + (estaAbierto ? 'expanded' : '') + '">' +
      '<div class="caso-h">' +
        '<div class="case-header">' +
          '<button type="button" class="case-toggle" aria-expanded="' + (estaAbierto ? 'true' : 'false') + '" title="' + (estaAbierto ? 'Collapse case' : 'Expand case') + '" onclick="toggleCase(' + caso.id + ')">' +
            '<span class="case-arrow">&#9654;</span>' +
          '</button>' +
          '<div class="case-summary">' +
            '<div class="case-summary-main">' +
              '<b>' + esc(caso.caseNumber) + '</b>' +
              '<span>' + esc(caso.employeeName) + '</span>' +
              '<span class="pill ' + esc(caso.riskLevel) + '">' + esc(caso.riskLevel) + '</span>' +
              '<span class="pill ' + esc(caso.status) + '">' + esc(caso.status) + '</span>' +
              (caso.confidential ? '<span class="pill CRITICO">CONFIDENTIAL</span>' : '') +
            '</div>' +
            '<div class="case-summary-secondary">' +
              esc(caso.department || '-') +
              ' &middot; Building ' + esc(caso.building || '-') +
              ' &middot; Area ' + esc(caso.workArea || '-') +
